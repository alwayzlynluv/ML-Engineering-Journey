        "    if epoch < 10:\n",
        "        return lr\n",
        "    else:\n",
        "        return lr * tf.math.exp(-0.1)\n",
        "\n",
        "lr_scheduler_callback = tf.keras.callbacks.LearningRateScheduler(lr_step_decay)"
